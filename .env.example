# Intelligence X API key (required)
# https://intelx.io/account
INTELX_API_KEY=

# --- Transport (HTTP mode) ---
# Set MCP_HTTP=1 to serve over HTTP instead of stdio
MCP_HTTP=1
# Port for the HTTP server (default: 3000)
PORT=3000
# Public base URL used to build one-time download links returned by
# intelx_file_read (encoding: "url"). Must be reachable from the client.
# Default: http://localhost:<PORT>
MCP_PUBLIC_URL=
